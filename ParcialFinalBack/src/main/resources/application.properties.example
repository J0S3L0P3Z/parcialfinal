spring.application.name=ParcialFinal

spring.datasource.url=jdbc:mysql://IP_DEL_SERVIDOR:3306/TU_ESQUEMA?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_CONTRASENA
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

server.port=8080
server.error.include-stacktrace=never
spring.jackson.default-property-inclusion=non_null

jwt.secret=CambienEstaClaveSecretaDeJwtPorUnaPropia2026
jwt.expiration-minutes=60

aes.key=CambiarLlave16ch
aes.iv=CambiarVector16c

app.cors-allowed-origins=http://localhost:4200,http://127.0.0.1:4200

app.seed.admin-username=admin
app.seed.admin-email=admin@parcial.local
app.seed.admin-password=Admin#12345
app.seed.user-username=normaluser
app.seed.user-email=normaluser@parcial.local
app.seed.user-password=Usuario#12345

app.external.base-url=https://uselessfacts.jsph.pl/api/v2

springdoc.swagger-ui.path=/
springdoc.swagger-ui.docExpansion=none
springdoc.swagger-ui.syntaxHighlight.activated=true
springdoc.swagger-ui.syntaxHighlight.theme=markdown
springdoc.swagger-ui.displayRequestDuration=true
springdoc.swagger-ui.filter=true
springdoc.swagger-ui.tryItOutEnabled=true
springdoc.swagger-ui.persistAuthorization=true
springdoc.swagger-ui.supportedSubmitMethods=["get", "post", "put", "delete"]
springdoc.swagger-ui.disable-swagger-default-url=true
